# ═══════════════════════════════════════════════════════════════════════════
# LSV.ai — Variables de configuration
# ───────────────────────────────────────────────────────────────────────────
# Ce fichier est un MODÈLE. Il est versionné.
# Le fichier réellement lu par l'application est : shared/config.js
#
# IMPORTANT : les valeurs de la partie "Front" sont PUBLIQUES par conception
# (clé "anon" Supabase, embarquée dans le navigateur). Elles ne sont PAS des
# secrets. Toute la sécurité repose sur :
#   - la LSV API Gateway (clé du fournisseur injectée côté serveur)
#   - les politiques Row Level Security (supabase/schema.sql)
#   - Supabase Auth (mots de passe hachés côté serveur) pour /admin
#
# Les vrais secrets (clé du fournisseur de génération, service_role key,
# mot de passe base de données, JWT signing key) ne doivent JAMAIS figurer
# ici ni dans le dépôt, ni dans le JavaScript servi au navigateur.
# ═══════════════════════════════════════════════════════════════════════════

# ── Front (public, vit dans shared/config.js) ──────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
LSV_GATEWAY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/lsv-gateway

# ── LSV API Gateway (Supabase Edge Function — secrets du service) ──────────
# Injection :  supabase secrets set AGNES_API_KEY=…
# Ces variables ne sont lues QUE par supabase/functions/lsv-gateway/.
# AGNES_API_KEY=YOUR_AGNES_API_KEY          # secret fournisseur (obligatoire)
# AGNES_API_BASE=https://...                # base amont (optionnel)
# ALLOWED_ORIGINS=https://fbici.github.io,http://localhost:4173
# RATE_LIMIT_PER_MIN=10                     # /minute et /IP + /visiteur
# IMAGE_LIMIT=0                             # /jour et /visiteur (0 = illimité)
# VIDEO_LIMIT=0
# CHAT_LIMIT=0
# MOTION_LIMIT=0
# MAX_BODY_BYTES=20971520                   # 20 Mo

# ── Variables JAMAIS commitées (exemple, hors dépôt) ──────────────────────
# SERVICE_ROLE_KEY=ne-jamais-dans-le-depot
# DB_PASSWORD=ne-jamais-dans-le-depot
